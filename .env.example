# Copy to .env and set a password. .env is git-ignored — never commit it.
# docker compose and the Python code both read these values.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inventory_control_tower
POSTGRES_USER=ict
POSTGRES_PASSWORD=choose_a_local_password

# Optional overrides
# SYNTHETIC_DATA_SEED=42
# RAW_DATA_DIR=
# PROCESSED_DATA_DIR=
# OUTPUT_DIR=
