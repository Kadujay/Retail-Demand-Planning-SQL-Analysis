.ipynb_checkpoints/

# Generated data: raw/processed data is reproducible from the seed.
# Small curated outputs/ CSVs ARE committed so reviewers see results
# without running anything.
data/raw/*
data/processed/*
data/synthetic_truth/*
data/raw_dirty/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic_truth/.gitkeep
*.parquet

# Power BI local artefacts
*.pbix.bak
dashboard/*.pbit.tmp

